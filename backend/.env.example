# ==========================================
# FLASK APPLICATION ENVIRONMENT CONFIGURATION
# ==========================================

# Flask Environment: development | testing | production
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-this-with-a-secure-random-secret-key

# Server Port
PORT=5000
HOST=0.0.0.0

# ==========================================
# DATABASE CONFIGURATION (MySQL)
# ==========================================
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=recruitment_db

# Optional: Directly override entire SQLAlchemy Database URI
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/recruitment_db

# ==========================================
# JWT AUTHENTICATION
# ==========================================
JWT_SECRET_KEY=replace-this-with-a-secure-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ==========================================
# CORS CONFIGURATION
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
